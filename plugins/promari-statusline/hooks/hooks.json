{
  "description": "promari-statusline: keep the installed status line binary at the plugin's version",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/psl\" hook SessionStart",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
