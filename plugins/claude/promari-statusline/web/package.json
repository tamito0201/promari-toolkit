{
  "name": "@promari/statusline-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "The web page of `psl dashboard`, built into internal/interfaces/dashboard/assets and embedded in the binary",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "test:coverage": "node --test --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/{api,browser,research,format,presentation,view-model,visualization,chart-math}.ts' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
